# 统一换行符：仓库内一律 LF，检出时也用 LF（避免 Windows/Linux 之间整树 diff）
* text=auto eol=lf

# 二进制/大文件：不做文本转换
*.png binary
*.jpg binary
*.zip binary
*.gz binary

# 明确按文本处理
*.md   text eol=lf
*.py   text eol=lf
*.json text eol=lf
*.csv  text eol=lf
*.svg  text eol=lf
*.mlir text eol=lf
*.tex  text eol=lf
*.bib  text eol=lf
