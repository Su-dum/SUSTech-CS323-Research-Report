{
  "_comment": [
    "抽象层级划分配置：dialect 命名空间 -> 层级 id。",
    "这是整项实验里唯一带主观判断的地方，也是你自己的学术贡献之一。",
    "请逐条审查、按你的理由修改，并在报告 §4 用一两句话说明划分依据与被归入 crosslayer 的判准。",
    "noise_dialects 是从统计中剔除的非方言命名空间，剔除理由写在 justification 里，必须在报告的方法节交代。",
    "凡未列出的 dialect 会落入 other，脚本会在 meta.json 里报告，便于你发现遗漏。"
  ],
  "layers": [
    {
      "id": "frontend",
      "label_zh": "框架/算子集导入层",
      "label_en": "framework / op-set import",
      "order": 1,
      "rationale": "承接深度学习框架或标准算子集，语义最贴近模型图，硬件无关。",
      "dialects": [
        "torch",
        "tosa",
        "stablehlo",
        "mhlo",
        "onnx",
        "ml_program"
      ]
    },
    {
      "id": "tensor",
      "label_zh": "张量代数/结构化计算层",
      "label_en": "tensor algebra / structured computation",
      "order": 2,
      "rationale": "以张量语义与结构化算子描述计算，是循环与并行变换的主要作用对象。",
      "dialects": [
        "linalg",
        "tensor",
        "sparse_tensor",
        "quant",
        "complex"
      ]
    },
    {
      "id": "parallel",
      "label_zh": "并行与控制抽象层",
      "label_en": "parallelism / control abstraction",
      "order": 3,
      "rationale": "描述并行执行、控制流与调度策略，尚未绑定具体存储与指令。",
      "dialects": [
        "scf",
        "affine",
        "cf",
        "async",
        "omp",
        "gpu",
        "shard",
        "mpi"
      ]
    },
    {
      "id": "memory_vector",
      "label_zh": "存储与向量层",
      "label_en": "memory / vector",
      "order": 4,
      "rationale": "把抽象值落到缓冲区与机器向量，是语义损失最集中的一段。",
      "dialects": [
        "memref",
        "vector",
        "bufferization",
        "ptr",
        "emitc"
      ]
    },
    {
      "id": "target",
      "label_zh": "硬件目标层",
      "label_en": "hardware target",
      "order": 5,
      "rationale": "直接对应 LLVM IR、SPIR-V 或某厂商指令集，硬件知识在此层进入。",
      "dialects": [
        "llvm",
        "spirv",
        "nvvm",
        "nvgpu",
        "rocdl",
        "amdgpu",
        "x86",
        "arm_neon",
        "arm_sve",
        "arm_sme",
        "xegpu",
        "vcix",
        "wasmssa",
        "acc",
        "xevm"
      ]
    }
  ],
  "crosslayer": {
    "_comment": "贯穿全栈的通用方言。它们不属于单一层，正是'跨层通用语'这一现象的证据，只在共现分析中使用。",
    "dialects": [
      "builtin",
      "func",
      "arith",
      "math",
      "index",
      "ub",
      "shape"
    ]
  },
