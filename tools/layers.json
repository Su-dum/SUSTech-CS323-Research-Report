  "infra": {
    "_comment": "编译器基础设施方言：描述编译过程本身（调度、匹配、方言定义、求解），不属于被编译程序的抽象层。单独统计并报告，不参与层映射。",
    "dialects": [
      "transform",
      "pdl",
      "pdl_interp",
      "irdl",
      "dlti",
      "smt"
    ]
  },
  "conversion_overrides": {
    "_comment": "Conversion 目录名无法用简单的 XToY 拆分时的人工覆盖。src/dst 用 dialect 命名空间；src 为 * 表示源方言不定（不计入层间边）。",
    "TosaToSPIRVTosa": {
      "src": "tosa",
      "dst": "spirv",
      "note": "TOSA 算子集降到 SPIR-V"
    },
    "MathToFuncs": {
      "src": "math",
      "dst": "func",
      "note": "math 降为 libm 等函数调用"
    },
    "ConvertToSPIRV": {
      "src": "*",
      "dst": "spirv",
      "note": "泛化的“转换为 SPIR-V”目录"
    },
    "ConvertToEmitC": {
      "src": "*",
      "dst": "emitc",
      "note": "泛化的“转换为 EmitC”目录"
    },
    "RaiseWasm": {
      "src": "wasmssa",
      "dst": "*",
      "note": "反向（raising）转换：WasmSSA 提升为 math/arith/cf，方向与下降相反，不计入层间边"
    },
    "GPUCommon": {
      "src": "*",
      "dst": "*",
      "note": "GPU 公共降级工具的测试夹具，源与目标都不定"
    },
    "LLVMCommon": {
      "src": "*",
      "dst": "*",
      "note": "LLVM 公共降级工具的测试夹具"
    },
    "ReconcileUnrealizedCasts": {
      "src": "*",
      "dst": "*",
      "note": "清理 unrealized_conversion_cast，不属于抽象层之间的转换"
    }
  }
